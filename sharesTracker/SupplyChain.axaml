<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1400"
        d:DesignHeight="900"
        x:Class="sharesTracker.SupplyChain"
        Title="Supply Chain Relationships"
        Width="1400"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        Background="#0B0F14"
        TransparencyLevelHint="Mica, AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">

	<Grid RowDefinitions="Auto,*">

		<!-- ========================================================= -->
		<!-- HEADER -->
		<!-- ========================================================= -->

		<Border Grid.Row="0"
                Background="#0B0F14"
                Padding="24,18,24,14">

			<StackPanel HorizontalAlignment="Center">

				<TextBlock x:Name="CompanyNameText"
                           HorizontalAlignment="Center"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#F8FAFC"
                           Text="SUPPLY CHAIN RELATIONSHIPS"/>

				<TextBlock x:Name="StatusText"
                           Text="Drag to pan • Mouse Wheel to zoom • Ctrl + Wheel for fine zoom • Click an edge for details"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>

			</StackPanel>

		</Border>


		<!-- ========================================================= -->
		<!-- GRAPH -->
		<!-- ========================================================= -->

		<Border Grid.Row="1"
                Margin="20,0,20,20"
                CornerRadius="16"
                Background="#0B0F14"
                BorderBrush="#1E293B"
                BorderThickness="1"
                ClipToBounds="True">

			<ScrollViewer x:Name="GraphScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="#0B0F14"
                          PointerWheelChanged="OnPointerWheelChanged">

				<Canvas x:Name="GraphCanvas"
                        Width="1800"
                        Height="1400"
                        Background="#0B0F14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"/>

			</ScrollViewer>

		</Border>


		<!-- ========================================================= -->
		<!-- RELATIONSHIP MODAL -->
		<!-- ========================================================= -->

		<Grid Grid.Row="0"
              Grid.RowSpan="2"
              x:Name="RelationshipOverlay"
              Background="#A0000000"
              IsVisible="False">

			<Border Width="540"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#151A21"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="24"
                    BoxShadow="0 12 40 0 #80000000">

				<StackPanel Spacing="16">

					<Grid ColumnDefinitions="*,Auto">

						<TextBlock x:Name="ModalHeaderTitle"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   Grid.Column="0"
                                   TextTrimming="CharacterEllipsis"/>

						<Button Content="✕"
                                Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#64748B"
                                FontSize="16"
                                FontWeight="Bold"
                                Click="CloseModal_Click"
                                Cursor="Hand"/>

					</Grid>


					<Rectangle Fill="#1E293B"
                               Height="1"/>


					<!-- Direction -->

					<Grid ColumnDefinitions="100,*">

						<TextBlock Text="Direction"
                                   FontSize="13"
                                   Foreground="#64748B"
                                   FontWeight="Bold"/>

						<TextBlock x:Name="ModalDirection"
                                   Grid.Column="1"
                                   FontSize="13"
                                   Foreground="#F8FAFC"
                                   FontWeight="SemiBold"/>

					</Grid>


					<!-- Category -->

					<Grid ColumnDefinitions="100,*">

						<TextBlock Text="Category"
                                   FontSize="13"
                                   Foreground="#64748B"
                                   FontWeight="Bold"/>

						<TextBlock x:Name="ModalCategory"
                                   Grid.Column="1"
                                   FontSize="13"
                                   Foreground="#60A5FA"
                                   TextWrapping="Wrap"/>

					</Grid>


					<!-- Function -->

					<StackPanel Spacing="6">

						<TextBlock Text="Function"
                                   FontSize="13"
                                   Foreground="#64748B"
                                   FontWeight="Bold"/>

						<TextBlock x:Name="ModalFunction"
                                   FontSize="13"
                                   Foreground="#CBD5E1"
                                   TextWrapping="Wrap"
                                   LineHeight="20"/>

					</StackPanel>


					<Button Content="Close"
                            HorizontalAlignment="Right"
                            Background="#1E293B"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            Foreground="#F8FAFC"
                            CornerRadius="8"
                            Padding="18,8"
                            Margin="0,10,0,0"
                            Click="CloseModal_Click"
                            Cursor="Hand"/>

				</StackPanel>

			</Border>

		</Grid>

	</Grid>

</Window>