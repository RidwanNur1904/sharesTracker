<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="sharesTracker.MainWindow"
        Title="Riddy Tracker"
        Width="1200"
        Height="750"
        MinWidth="900"
        MinHeight="600"
        Background="#1E1E1E">

	<Grid RowDefinitions="60,*,30">

		<!-- ========================= -->
		<!-- TOP BAR -->
		<!-- ========================= -->

		<Border Grid.Row="0"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="0,0,0,1">

			<Grid ColumnDefinitions="220,*,120">

				<TextBlock Grid.Column="0"
                           Text="RIDDY TRACKER"
                           VerticalAlignment="Center"
                           Margin="20,0"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#DCDCAA"/>

				<TextBox Grid.Column="1"
                         x:Name="SearchBox"
                         Watermark="Enter stock symbol e.g. AAPL"
                         Margin="10"
                         Height="36"
                         VerticalAlignment="Center"
                         Background="#1E1E1E"
                         Foreground="#D4D4D4"
                         BorderBrush="#3E3E42"/>

				<Button Grid.Column="2"
                        Content="SEARCH"
                        Click="Search_Click"
                        Margin="10"
                        Height="36"
                        VerticalAlignment="Center"
                        Background="#569CD6"
                        Foreground="White"
                        BorderThickness="0"/>

			</Grid>

		</Border>


		<!-- ========================= -->
		<!-- MAIN CONTENT -->
		<!-- ========================= -->

		<Grid Grid.Row="1"
              ColumnDefinitions="240,*,280">


			<!-- ========================= -->
			<!-- WATCHLIST -->
			<!-- ========================= -->

			<Border Grid.Column="0"
                    Margin="10"
                    Background="#252526"
                    BorderBrush="#3E3E42"
                    BorderThickness="1">

				<Grid RowDefinitions="50,*">

					<TextBlock Grid.Row="0"
                               Text="WATCHLIST"
                               Margin="15,0"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#D4D4D4"/>


					<ListBox Grid.Row="1"
                             x:Name="StocksList"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="Stock_Selected">

						<ListBoxItem Content="AAPL"/>

						<ListBoxItem Content="MSFT"/>

						<ListBoxItem Content="NVDA"/>

						<ListBoxItem Content="AMZN"/>

						<ListBoxItem Content="GOOGL"/>

						<ListBoxItem Content="META"/>

						<ListBoxItem Content="TSLA"/>

						<ListBoxItem Content="AVGO"/>

						<ListBoxItem Content="NFLX"/>

						<ListBoxItem Content="AMD"/>

					</ListBox>

				</Grid>

			</Border>


			<!-- ========================= -->
			<!-- STOCK GRAPH -->
			<!-- ========================= -->

			<Border Grid.Column="1"
                    Margin="0,10,10,10"
                    Background="#252526"
                    BorderBrush="#3E3E42"
                    BorderThickness="1">

				<Grid RowDefinitions="80,*">

					<!-- STOCK HEADER -->

					<Grid Grid.Row="0"
                          ColumnDefinitions="*,150">

						<StackPanel Margin="15,10">

							<TextBlock x:Name="StockSymbol"
                                       Text="AAPL"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#D4D4D4"/>

							<TextBlock x:Name="StockName"
                                       Text="Apple Inc."
                                       FontSize="13"
                                       Foreground="#808080"/>

						</StackPanel>


						<TextBlock Grid.Column="1"
                                   x:Name="StockPrice"
                                   Text="--"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"
                                   Foreground="#4EC9B0"/>

					</Grid>


					<!-- GRAPH -->

					<Border Grid.Row="1"
        Margin="15"
        Background="#1E1E1E"
        BorderBrush="#3E3E42"
        BorderThickness="1">

						<Panel x:Name="GraphPanel"
							   Background="#1E1E1E"/>

					</Border>

				</Grid>

			</Border>


			<!-- ========================= -->
			<!-- MARKET DATA -->
			<!-- ========================= -->

			<Border Grid.Column="2"
                    Margin="0,10,10,10"
                    Background="#252526"
                    BorderBrush="#3E3E42"
                    BorderThickness="1">

				<ScrollViewer>

					<StackPanel Margin="15">

						<TextBlock Text="MARKET DATA"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#D4D4D4"
                                   Margin="0,0,0,20"/>


						<TextBlock Text="OPEN"
                                   Foreground="#808080"/>

						<TextBlock x:Name="OpenText"
                                   Text="--"
                                   FontSize="18"
                                   Foreground="#D4D4D4"
                                   Margin="0,3,0,15"/>


						<TextBlock Text="HIGH"
                                   Foreground="#808080"/>

						<TextBlock x:Name="HighText"
                                   Text="--"
                                   FontSize="18"
                                   Foreground="#4EC9B0"
                                   Margin="0,3,0,15"/>


						<TextBlock Text="LOW"
                                   Foreground="#808080"/>

						<TextBlock x:Name="LowText"
                                   Text="--"
                                   FontSize="18"
                                   Foreground="#F44747"
                                   Margin="0,3,0,15"/>


						<TextBlock Text="PREVIOUS CLOSE"
                                   Foreground="#808080"/>

						<TextBlock x:Name="PreviousCloseText"
                                   Text="--"
                                   FontSize="18"
                                   Foreground="#D4D4D4"
                                   Margin="0,3,0,15"/>


						<TextBlock Text="VOLUME"
                                   Foreground="#808080"/>

						<TextBlock x:Name="VolumeText"
                                   Text="--"
                                   FontSize="18"
                                   Foreground="#D4D4D4"
                                   Margin="0,3,0,15"/>


						<TextBlock Text="CHANGE"
                                   Foreground="#808080"/>

						<TextBlock x:Name="ChangeText"
                                   Text="--"
                                   FontSize="18"
                                   Foreground="#4EC9B0"
                                   Margin="0,3,0,15"/>


						<TextBlock Text="CHANGE %"
                                   Foreground="#808080"/>

						<TextBlock x:Name="ChangePercentText"
                                   Text="--"
                                   FontSize="18"
                                   Foreground="#4EC9B0"/>

					</StackPanel>

				</ScrollViewer>

			</Border>

		</Grid>


		<!-- ========================= -->
		<!-- STATUS BAR -->
		<!-- ========================= -->

		<Border Grid.Row="2"
                Background="#007ACC">

			<TextBlock x:Name="StatusText"
                       Text="Starting Riddy Tracker..."
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="10,0"/>

		</Border>

	</Grid>

</Window>

