<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="sharesTracker.MainWindow"
        Title="Riddy Tracker"
        Width="1200"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        Background="Transparent"
        TransparencyLevelHint="Mica, AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">

	<Grid RowDefinitions="Auto,Auto,*">

		<!-- ========================= -->
		<!-- TOP BAR / HEADER -->
		<!-- ========================= -->
		<Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Margin="20,10,20,10">

			<!-- Title -->
			<StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="8">

				<TextBlock Text="RIDDY TRACKER"
                           FontSize="15"
                           FontWeight="Bold"
                           LetterSpacing="0.5"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                           VerticalAlignment="Center"/>
			</StackPanel>

			<!-- Search Bar (Centered Pill) -->
			<Grid Grid.Column="1"
                  HorizontalAlignment="Center"
                  Width="420">

				<TextBox x:Name="SearchBox"
                         Watermark="Search stock symbol e.g. AAPL..."
                         Height="36"
                         CornerRadius="18"
                         Padding="16,0,40,0"
                         VerticalContentAlignment="Center"
                         Background="#20FFFFFF"
                         BorderBrush="#15FFFFFF"
                         BorderThickness="1"/>

				<Button Content="🔍"
                        Click="Search_Click"
                        HorizontalAlignment="Right"
                        Width="32"
                        Height="32"
                        Margin="0,0,3,0"
                        CornerRadius="16"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"/>
			</Grid>
		</Grid>

		<!-- ========================= -->
		<!-- GLOBAL EXCHANGES BAR -->
		<!-- ========================= -->
		<Border Grid.Row="1"
                Margin="20,0,20,10"
                Padding="16,8"
                CornerRadius="12"
                Background="#1A121824"
                BorderBrush="#15FFFFFF"
                BorderThickness="1">

			<ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">

				<StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="24">

					<!-- NYSE / NASDAQ -->
					<StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">

						<TextBlock Text="NYSE / NASDAQ:"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#A0AEC0"/>

						<TextBlock x:Name="ClockNyse"
                                   Text="00:00:00"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

						<TextBlock x:Name="StatusNyse"
                                   Text="CLOSED"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#F87171"
                                   VerticalAlignment="Center"/>
					</StackPanel>

					<Rectangle Width="1"
                               Height="14"
                               Fill="#20FFFFFF"/>

					<!-- LSE (London) -->
					<StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">

						<TextBlock Text="LSE (London):"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#A0AEC0"/>

						<TextBlock x:Name="ClockLse"
                                   Text="00:00:00"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

						<TextBlock x:Name="StatusLse"
                                   Text="CLOSED"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#F87171"
                                   VerticalAlignment="Center"/>
					</StackPanel>

					<Rectangle Width="1"
                               Height="14"
                               Fill="#20FFFFFF"/>

					<!-- FRANKFURT (XETRA) -->
					<StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">

						<TextBlock Text="Frankfurt:"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#A0AEC0"/>

						<TextBlock x:Name="ClockFrankfurt"
                                   Text="00:00:00"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

						<TextBlock x:Name="StatusFrankfurt"
                                   Text="CLOSED"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#F87171"
                                   VerticalAlignment="Center"/>
					</StackPanel>

					<Rectangle Width="1"
                               Height="14"
                               Fill="#20FFFFFF"/>

					<!-- TOKYO (TSE) -->
					<StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">

						<TextBlock Text="TSE (Tokyo):"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#A0AEC0"/>

						<TextBlock x:Name="ClockTse"
                                   Text="00:00:00"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

						<TextBlock x:Name="StatusTse"
                                   Text="CLOSED"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#F87171"
                                   VerticalAlignment="Center"/>
					</StackPanel>

					<Rectangle Width="1"
                               Height="14"
                               Fill="#20FFFFFF"/>

					<!-- HONG KONG (HKEX) -->
					<StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">

						<TextBlock Text="HKEX (Hong Kong):"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#A0AEC0"/>

						<TextBlock x:Name="ClockHkex"
                                   Text="00:00:00"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

						<TextBlock x:Name="StatusHkex"
                                   Text="CLOSED"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#F87171"
                                   VerticalAlignment="Center"/>
					</StackPanel>
				</StackPanel>
			</ScrollViewer>
		</Border>

		<!-- ========================= -->
		<!-- MAIN DASHBOARD CONTENT -->
		<!-- ========================= -->
		<Grid Grid.Row="2"
              ColumnDefinitions="260,*"
              Margin="15,0,15,15">

			<!-- WATCHLIST PANEL -->
			<Border Grid.Column="0"
                    Margin="5"
                    CornerRadius="16"
                    Background="#25121824"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="1">

				<Grid RowDefinitions="Auto,*">

					<TextBlock Grid.Row="0"
                               Text="WATCHLIST"
                               Margin="20,18,20,10"
                               FontSize="12"
                               FontWeight="Bold"
                               LetterSpacing="0.5"
                               Foreground="#A0AEC0"/>

					<ListBox Grid.Row="1"
                             x:Name="StocksList"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="8"
                             SelectionChanged="Stock_Selected">

						<ListBox.Styles>
							<Style Selector="ListBoxItem">
								<Setter Property="CornerRadius"
                                        Value="10"/>
								<Setter Property="Margin"
                                        Value="0,2"/>
								<Setter Property="Padding"
                                        Value="14,10"/>
								<Setter Property="FontWeight"
                                        Value="SemiBold"/>
							</Style>
						</ListBox.Styles>

						<ListBoxItem Content="AAPL"/>
						<ListBoxItem Content="MSFT"/>
						<ListBoxItem Content="NVDA"/>
						<ListBoxItem Content="AMZN"/>
						<ListBoxItem Content="GOOGL"/>
						<ListBoxItem Content="META"/>
						<ListBoxItem Content="TSLA"/>
						<ListBoxItem Content="AVGO"/>
						<ListBoxItem Content="NFLX"/>
						<ListBoxItem Content="AMD"/>
					</ListBox>
				</Grid>
			</Border>

			<!-- MARKET DATA DASHBOARD -->
			<Grid Grid.Column="1"
                  RowDefinitions="Auto,*"
                  Margin="5">

				<!-- HERO / STOCK HEADER -->
				<StackPanel Grid.Row="0"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,20"
                            Spacing="4">

					<TextBlock x:Name="StockSymbol"
                               Text="AAPL"
                               FontSize="32"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

					<TextBlock x:Name="StockName"
                               Text="Apple Inc."
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Foreground="#A0AEC0"/>

					<TextBlock x:Name="StockPrice"
                               Text="$--"
                               FontSize="44"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
				</StackPanel>

				<!-- METRICS GRID (CARDS) -->
				<ScrollViewer Grid.Row="1">

					<!-- Added Row 4 for Supply Chain button -->
					<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          ColumnDefinitions="*,*,*"
                          Margin="0,0,5,0">

						<!-- CARD: OPEN -->
						<Border Grid.Row="0"
                                Grid.Column="0"
                                Margin="6"
                                Padding="16"
                                CornerRadius="14"
                                Background="#25121824"
                                BorderBrush="#15FFFFFF"
                                BorderThickness="1">

							<StackPanel Spacing="6">
								<TextBlock Text="OPEN"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#A0AEC0"/>

								<TextBlock x:Name="OpenText"
                                           Text="--"
                                           FontSize="22"
                                           FontWeight="Bold"/>
							</StackPanel>
						</Border>

						<!-- CARD: HIGH -->
						<Border Grid.Row="0"
                                Grid.Column="1"
                                Margin="6"
                                Padding="16"
                                CornerRadius="14"
                                Background="#25121824"
                                BorderBrush="#15FFFFFF"
                                BorderThickness="1">

							<StackPanel Spacing="6">
								<TextBlock Text="HIGH"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#A0AEC0"/>

								<TextBlock x:Name="HighText"
                                           Text="--"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#4ADE80"/>
							</StackPanel>
						</Border>

						<!-- CARD: LOW -->
						<Border Grid.Row="0"
                                Grid.Column="2"
                                Margin="6"
                                Padding="16"
                                CornerRadius="14"
                                Background="#25121824"
                                BorderBrush="#15FFFFFF"
                                BorderThickness="1">

							<StackPanel Spacing="6">
								<TextBlock Text="LOW"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#A0AEC0"/>

								<TextBlock x:Name="LowText"
                                           Text="--"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#F87171"/>
							</StackPanel>
						</Border>

						<!-- CARD: PREVIOUS CLOSE -->
						<Border Grid.Row="1"
                                Grid.Column="0"
                                Margin="6"
                                Padding="16"
                                CornerRadius="14"
                                Background="#25121824"
                                BorderBrush="#15FFFFFF"
                                BorderThickness="1">

							<StackPanel Spacing="6">
								<TextBlock Text="PREVIOUS CLOSE"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#A0AEC0"/>

								<TextBlock x:Name="PreviousCloseText"
                                           Text="--"
                                           FontSize="22"
                                           FontWeight="Bold"/>
							</StackPanel>
						</Border>

						<!-- CARD: VOLUME -->
						<Border Grid.Row="1"
                                Grid.Column="1"
                                Margin="6"
                                Padding="16"
                                CornerRadius="14"
                                Background="#25121824"
                                BorderBrush="#15FFFFFF"
                                BorderThickness="1">

							<StackPanel Spacing="6">
								<TextBlock Text="VOLUME"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#A0AEC0"/>

								<TextBlock x:Name="VolumeText"
                                           Text="--"
                                           FontSize="22"
                                           FontWeight="Bold"/>
							</StackPanel>
						</Border>

						<!-- CARD: CHANGE -->
						<Border Grid.Row="1"
                                Grid.Column="2"
                                Margin="6"
                                Padding="16"
                                CornerRadius="14"
                                Background="#25121824"
                                BorderBrush="#15FFFFFF"
                                BorderThickness="1">

							<StackPanel Spacing="6">
								<TextBlock Text="CHANGE"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#A0AEC0"/>

								<TextBlock x:Name="ChangeText"
                                           Text="--"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#4ADE80"/>
							</StackPanel>
						</Border>

						<!-- CARD: CHANGE PERCENT -->
						<Border Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Margin="6"
                                Padding="16"
                                CornerRadius="14"
                                Background="#25121824"
                                BorderBrush="#15FFFFFF"
                                BorderThickness="1">

							<Grid ColumnDefinitions="Auto,*">

								<StackPanel Grid.Column="0"
                                            Spacing="4">

									<TextBlock Text="CHANGE %"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#A0AEC0"/>

									<TextBlock x:Name="ChangePercentText"
                                               Text="--"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#4ADE80"/>
								</StackPanel>

								<TextBlock Grid.Column="1"
                                           x:Name="StatusText"
                                           Text="Starting Riddy Tracker..."
                                           FontSize="12"
                                           Foreground="#80A0AEC0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"/>
							</Grid>
						</Border>

						<!-- CARD: NEWS -->
						<Border Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Margin="6"
                                Padding="18"
                                CornerRadius="14"
                                Background="#25121824"
                                BorderBrush="#15FFFFFF"
                                BorderThickness="1">

							<StackPanel Spacing="12">

								<TextBlock Text="LATEST NEWS"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#A0AEC0"/>

								<StackPanel x:Name="NewsHeadline1Panel"
                                            Spacing="4">

									<TextBlock x:Name="NewsHeadline1Title"
                                               Text="--"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Cursor="Hand"
                                               PointerPressed="NewsHeadline1_Click"/>

									<TextBlock x:Name="NewsHeadline1Meta"
                                               Text=""
                                               FontSize="11"
                                               Foreground="#A0AEC0"/>
								</StackPanel>

								<Rectangle Height="1"
                                           Fill="#10FFFFFF"/>

								<StackPanel x:Name="NewsHeadline2Panel"
                                            Spacing="4">

									<TextBlock x:Name="NewsHeadline2Title"
                                               Text="--"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Cursor="Hand"
                                               PointerPressed="NewsHeadline2_Click"/>

									<TextBlock x:Name="NewsHeadline2Meta"
                                               Text=""
                                               FontSize="11"
                                               Foreground="#A0AEC0"/>
								</StackPanel>
							</StackPanel>
						</Border>

						
						<!-- ========================= -->
						<!-- SUPPLY CHAIN BUTTON -->
						<!-- ========================= -->
						<Button Grid.Row="4"
								Grid.Column="0"
								Grid.ColumnSpan="3"
								Content="SUPPLY CHAIN"
								Width="240"
								Height="60"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Margin="6,12,6,12"
								CornerRadius="16"
								FontSize="17"
								FontWeight="Bold"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								Background="#25121824"
								BorderBrush="#20FFFFFF"
								BorderThickness="1"
								Cursor="Hand"
								Click="SupplyChain_Click"/>
						


					</Grid>
				</ScrollViewer>
			</Grid>
		</Grid>
	</Grid>
</Window>

