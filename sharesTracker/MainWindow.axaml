<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="sharesTracker.MainWindow"
        Title="Riddy Tracker"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        Background="Transparent"
        TransparencyLevelHint="Mica, AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">

	<Grid RowDefinitions="Auto,*">
		<!-- ========================= -->
		<!-- TOP BAR / HEADER -->
		<!-- ========================= -->
		<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="20,15,20,10">
			<!-- Title -->
			<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
				<TextBlock Text="RIDDY TRACKER"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#E2E8F0"
                           VerticalAlignment="Center"/>
			</StackPanel>

			<!-- Search Bar (Centered Pill) -->
			<Grid Grid.Column="1" HorizontalAlignment="Center" Width="420">
				<TextBox x:Name="SearchBox"
                         Watermark="Search stock symbol e.g. AAPL..."
                         Height="36"
                         CornerRadius="18"
                         Padding="15,0"
                         VerticalContentAlignment="Center"
                         Background="#30FFFFFF"
                         Foreground="#FFFFFF"
                         BorderBrush="#20FFFFFF"
                         BorderThickness="1"/>
				<Button Content="🔍"
                        Click="Search_Click"
                        HorizontalAlignment="Right"
                        Width="32"
                        Height="32"
                        Margin="0,0,4,0"
                        CornerRadius="16"
                        Background="Transparent"
                        Foreground="#E2E8F0"
                        BorderThickness="0"/>
			</Grid>
		</Grid>

		<!-- ========================= -->
		<!-- MAIN DASHBOARD CONTENT -->
		<!-- ========================= -->
		<Grid Grid.Row="1" ColumnDefinitions="260,*" Margin="15,0,15,15">

			<!-- WATCHLIST PANEL -->
			<Border Grid.Column="0"
                    Margin="5"
                    CornerRadius="16"
                    Background="#35121824"
                    BorderBrush="#25FFFFFF"
                    BorderThickness="1">
				<Grid RowDefinitions="Auto,*">
					<TextBlock Grid.Row="0"
                               Text="WATCHLIST"
                               Margin="20,18,20,10"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#A0AEC0"/>

					<ListBox Grid.Row="1"
                             x:Name="StocksList"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="8"
                             SelectionChanged="Stock_Selected">
						<ListBox.Styles>
							<Style Selector="ListBoxItem">
								<Setter Property="CornerRadius" Value="10"/>
								<Setter Property="Margin" Value="0,2"/>
								<Setter Property="Padding" Value="12,8"/>
								<Setter Property="Foreground" Value="#E2E8F0"/>
							</Style>
						</ListBox.Styles>
						<ListBoxItem Content="AAPL"/>
						<ListBoxItem Content="MSFT"/>
						<ListBoxItem Content="NVDA"/>
						<ListBoxItem Content="AMZN"/>
						<ListBoxItem Content="GOOGL"/>
						<ListBoxItem Content="META"/>
						<ListBoxItem Content="TSLA"/>
						<ListBoxItem Content="AVGO"/>
						<ListBoxItem Content="NFLX"/>
						<ListBoxItem Content="AMD"/>
					</ListBox>
				</Grid>
			</Border>

			<!-- MARKET DATA DASHBOARD -->
			<Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="5">

				<!-- HERO / STOCK HEADER -->
				<StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,25" Spacing="4">
					<TextBlock x:Name="StockSymbol"
                               Text="AAPL"
                               FontSize="32"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="#FFFFFF"/>
					<TextBlock x:Name="StockName"
                               Text="Apple Inc."
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Foreground="#A0AEC0"/>
					<TextBlock x:Name="StockPrice"
                               Text="$--"
                               FontSize="42"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Foreground="#FFFFFF"/>
				</StackPanel>

				<!-- METRICS GRID (CARDS) -->
				<ScrollViewer Grid.Row="1">
					<Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*,*" Margin="0,0,5,0">

						<!-- CARD: OPEN -->
						<Border Grid.Row="0" Grid.Column="0" Margin="6" Padding="16" CornerRadius="14" Background="#35121824" BorderBrush="#20FFFFFF" BorderThickness="1">
							<StackPanel Spacing="6">
								<TextBlock Text="OPEN" FontSize="12" FontWeight="SemiBold" Foreground="#A0AEC0"/>
								<TextBlock x:Name="OpenText" Text="--" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
							</StackPanel>
						</Border>

						<!-- CARD: HIGH -->
						<Border Grid.Row="0" Grid.Column="1" Margin="6" Padding="16" CornerRadius="14" Background="#35121824" BorderBrush="#20FFFFFF" BorderThickness="1">
							<StackPanel Spacing="6">
								<TextBlock Text="HIGH" FontSize="12" FontWeight="SemiBold" Foreground="#A0AEC0"/>
								<TextBlock x:Name="HighText" Text="--" FontSize="22" FontWeight="Bold" Foreground="#4ADE80"/>
							</StackPanel>
						</Border>

						<!-- CARD: LOW -->
						<Border Grid.Row="0" Grid.Column="2" Margin="6" Padding="16" CornerRadius="14" Background="#35121824" BorderBrush="#20FFFFFF" BorderThickness="1">
							<StackPanel Spacing="6">
								<TextBlock Text="LOW" FontSize="12" FontWeight="SemiBold" Foreground="#A0AEC0"/>
								<TextBlock x:Name="LowText" Text="--" FontSize="22" FontWeight="Bold" Foreground="#F87171"/>
							</StackPanel>
						</Border>

						<!-- CARD: PREVIOUS CLOSE -->
						<Border Grid.Row="1" Grid.Column="0" Margin="6" Padding="16" CornerRadius="14" Background="#35121824" BorderBrush="#20FFFFFF" BorderThickness="1">
							<StackPanel Spacing="6">
								<TextBlock Text="PREVIOUS CLOSE" FontSize="12" FontWeight="SemiBold" Foreground="#A0AEC0"/>
								<TextBlock x:Name="PreviousCloseText" Text="--" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
							</StackPanel>
						</Border>

						<!-- CARD: VOLUME -->
						<Border Grid.Row="1" Grid.Column="1" Margin="6" Padding="16" CornerRadius="14" Background="#35121824" BorderBrush="#20FFFFFF" BorderThickness="1">
							<StackPanel Spacing="6">
								<TextBlock Text="VOLUME" FontSize="12" FontWeight="SemiBold" Foreground="#A0AEC0"/>
								<TextBlock x:Name="VolumeText" Text="--" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
							</StackPanel>
						</Border>

						<!-- CARD: CHANGE -->
						<Border Grid.Row="1" Grid.Column="2" Margin="6" Padding="16" CornerRadius="14" Background="#35121824" BorderBrush="#20FFFFFF" BorderThickness="1">
							<StackPanel Spacing="6">
								<TextBlock Text="CHANGE" FontSize="12" FontWeight="SemiBold" Foreground="#A0AEC0"/>
								<TextBlock x:Name="ChangeText" Text="--" FontSize="22" FontWeight="Bold" Foreground="#4ADE80"/>
							</StackPanel>
						</Border>

						<!-- CARD: CHANGE PERCENT -->
						<Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="6" Padding="16" CornerRadius="14" Background="#35121824" BorderBrush="#20FFFFFF" BorderThickness="1">
							<Grid ColumnDefinitions="Auto,*">
								<StackPanel Grid.Column="0" Spacing="4">
									<TextBlock Text="CHANGE %" FontSize="12" FontWeight="SemiBold" Foreground="#A0AEC0"/>
									<TextBlock x:Name="ChangePercentText" Text="--" FontSize="22" FontWeight="Bold" Foreground="#4ADE80"/>
								</StackPanel>
								<TextBlock Grid.Column="1"
                                           x:Name="StatusText"
                                           Text="Starting Riddy Tracker..."
                                           FontSize="12"
                                           Foreground="#80A0AEC0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"/>
							</Grid>
						</Border>

					</Grid>
				</ScrollViewer>
			</Grid>
		</Grid>
	</Grid>
</Window>